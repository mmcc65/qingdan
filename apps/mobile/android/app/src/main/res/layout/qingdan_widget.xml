<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qingdan_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout style="@style/WidgetHeader">
        <TextView
            android:id="@+id/widget_previous"
            style="@style/WidgetNavigation"
            android:text="‹"
            android:contentDescription="上一类" />
        <TextView
            android:id="@+id/widget_title"
            style="@style/WidgetTitle"
            android:text="清单 · 待办 0" />
        <TextView
            android:id="@+id/widget_next"
            style="@style/WidgetNavigation"
            android:text="›"
            android:contentDescription="下一类" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无内容"
        android:textColor="#7C857F"
        android:textSize="12sp" />
</LinearLayout>
