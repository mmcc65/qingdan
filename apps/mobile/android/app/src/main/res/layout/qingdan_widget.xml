<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/qingdan_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="2dp"
        android:text="清单 · 待办"
        android:textColor="#203F34"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout android:id="@+id/widget_row_1" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_1" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_1" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_2" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_2" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_2" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_3" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_3" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_3" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_4" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_4" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_4" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_5" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_5" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_5" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_6" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_6" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_6" style="@style/WidgetTask"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row_7" style="@style/WidgetRow"><TextView android:id="@+id/widget_complete_7" style="@style/WidgetCheck"/><TextView android:id="@+id/widget_task_7" style="@style/WidgetTask"/></LinearLayout>
</LinearLayout>
